// Dutch (Netherlands) Windows 11 presentation resource for Interface Setup.
// Keep all control IDs aligned with Rsrc.rc; presentation/localization only.

#include "resrc1.h"
#include "windows.h"
#include "headers\resource.h"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH
#pragma code_page(65001)

SETUPDLGBOX DIALOGEX 10, 10, 360, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - Interface-instellingen"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Stel de seriële interface en audio-invoer in.",IDC_STATIC,16,14,328,12

    GROUPBOX        "Seriële interface",IDC_STATIC,16,38,328,84
    CONTROL         "Seriële poort inschakelen",IDC_COMENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,28,54,148,12
    LTEXT           "Poort:",IDC_STATIC,28,78,36,10
    COMBOBOX        IDC_COMPORT,68,75,60,70,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Modus:",IDC_STATIC,142,78,40,10
    COMBOBOX        IDC_RS232MODE,186,75,70,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_LEVEL,268,75,60,50,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    CONTROL         "Slicer",IDC_COMSLICER,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,28,101,54,12
    CONTROL         "RS232",IDC_COMRS232,"Button",BS_AUTORADIOBUTTON | WS_TABSTOP,88,101,54,12
    LTEXT           "Adres:",IDC_STATIC,154,102,34,10
    EDITTEXT        IDC_COMADDR,192,99,42,18,ES_CENTER | ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP
    LTEXT           "IRQ:",IDC_STATIC,246,102,24,10
    COMBOBOX        IDC_COMIRQ,274,99,54,90,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Audio-invoer",IDC_STATIC,16,132,328,84
    CONTROL         "Geluidskaart inschakelen",IDC_AUDIOENABLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,28,148,144,12
    LTEXT           "Configuratie:",IDC_STATIC,28,172,62,10
    COMBOBOX        IDC_AUDIOCONFIG,94,169,126,130,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Aangepast...",IDC_AUDIOCUSTOM,232,169,96,20
    LTEXT           "Samplefrequentie:",IDC_STATIC,28,198,84,10
    COMBOBOX        IDC_AUDIOSAMPLERATE,116,195,70,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Geluidskaart:",IDC_STATIC,200,198,62,10
    COMBOBOX        IDC_AUDIODEVICES,266,195,62,60,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP

    DEFPUSHBUTTON   "OK",IDOK,196,228,66,20
    PUSHBUTTON      "Annuleren",IDCANCEL,278,228,66,20
END
