FILTERFINDDLGBOX DIALOGEX 10, 10, 280, 132
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - Filter zoeken"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Zoeken:",IDC_STATIC,16,18,48,10
    EDITTEXT        IDC_FILTERFIND,70,15,194,18,ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Treffers:",IDC_STATIC,16,48,48,10
    LTEXT           "0",IDC_FILTERFIND_HITS,70,48,42,10
