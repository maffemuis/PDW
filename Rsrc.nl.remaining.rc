END

FILTERCHECKDUPLICATEDLGBOX DIALOGEX 10, 10, 430, 144
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - Dubbele filters controleren"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Controleer de filterlijst op dubbele items.",IDC_STATIC,16,14,398,12
    LISTBOX         IDC_FILTERFIND_DUPLICATE,16,38,398,34,LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | WS_TABSTOP
    CONTROL         "Progress1",IDC_PROGRESS1,"msctls_progress32",PBS_SMOOTH | WS_BORDER,16,82,360,12
    RTEXT           "0%",IDC_FILTERDUP_PCT,380,82,34,10
    DEFPUSHBUTTON   "Zoeken",IDOK,258,108,72,20
    PUSHBUTTON      "Sluiten",IDCANCEL,342,108,72,20
