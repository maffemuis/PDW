// Dutch (Netherlands) Windows 11 presentation resources for remaining core dialogs.
// Keep all control IDs aligned with Rsrc.rc; presentation/localization only.

#include "resrc1.h"
#include "windows.h"
#include "headers\resource.h"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH
#pragma code_page(65001)

OPTIONSDLGBOX DIALOGEX 10, 10, 500, 430
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - Decoderopties"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "POCSAG",IDC_STATIC,16,14,468,82
    CONTROL         "POCSAG-decodering inschakelen",IDC_DECODEPOCSAG,"Button",BS_AUTOCHECKBOX | BS_NOTIFY | WS_DISABLED | WS_TABSTOP,28,31,154,12
    CONTROL         "512",IDC_POCSAG_512,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,202,31,46,12
    CONTROL         "1200",IDC_POCSAG_1200,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,258,31,48,12
    CONTROL         "2400",IDC_POCSAG_2400,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,316,31,48,12
    CONTROL         "Functienummers altijd als standaard decoderen (1=Numeriek, 2=Toon, 3=Toon, 4=Alfanumeriek)",IDC_POCSAG_FNU,"Button",BS_AUTOCHECKBOX | BS_NOTIFY | WS_DISABLED | WS_TABSTOP,28,53,440,12
    CONTROL         "Bij twijfel bericht zowel numeriek als alfanumeriek tonen",IDC_POCSAG_BOTH,"Button",BS_AUTOCHECKBOX | BS_NOTIFY | WS_DISABLED | WS_TABSTOP,28,73,330,12

    GROUPBOX        "FLEX",IDC_STATIC,16,104,468,60
    CONTROL         "FLEX-decodering inschakelen",IDC_DECODEFLEX,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,121,142,12
    CONTROL         "1600",IDC_FLEX_1600,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,202,121,48,12
    CONTROL         "3200",IDC_FLEX_3200,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,258,121,48,12
    CONTROL         "6400",IDC_FLEX_6400,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,316,121,48,12
    CONTROL         "Korte instructies tonen",IDC_SHOWINSTR,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,143,112,12
    CONTROL         "Korte instructies naar tekst omzetten",IDC_CONVERT_SI,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,152,143,178,12
    CONTROL         "FLEX-tijd gebruiken (niet gedetecteerd)",IDC_FLEXTIME,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,338,143,140,12

    GROUPBOX        "MOBITEX",IDC_STATIC,16,172,468,112
    LTEXT           "Bitsync:",IDC_STATIC,28,190,44,10
    COMBOBOX        IDC_MB_BITSYNC,76,187,54,50,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bitrate:",IDC_STATIC,144,190,44,10
    COMBOBOX        IDC_MB_BITRATE,192,187,54,50,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Framesync:",IDC_STATIC,260,190,54,10
    EDITTEXT        IDC_MB_FRSYNC,318,187,42,18,ES_CENTER | ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP
    LTEXT           "Min. tekens:",IDC_STATIC,374,190,54,10
    EDITTEXT        IDC_MB_MIN_MSG,432,187,36,18,ES_CENTER | ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP
    CONTROL         "Bitscrambler",IDC_MB_BITSCRAMBLER,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,214,82,12
    CONTROL         "Ramnet",IDC_MB_RAMNET,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,122,214,58,12
    CONTROL         "Framesync controleren",IDC_MB_USEFRSYNC,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,194,214,112,12
    CONTROL         "Netwerkberichten tonen",IDC_MB_SHOWMPAK,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,236,118,12
    CONTROL         "TEXT tonen",IDC_MB_SHOWTEXT,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,158,236,72,12
    CONTROL         "DATA tonen",IDC_MB_SHOWDATA,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,242,236,74,12
    CONTROL         "HPDATA tonen",IDC_MB_SHOWHPDATA,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,328,236,82,12
    CONTROL         "Uitgebreid (besturingsberichten)",IDC_MB_VERBOSE,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,258,152,12
    CONTROL         "Sweepframes tonen (BaseInfo)",IDC_MB_SHOWSWEEP,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,194,258,142,12
    CONTROL         "HPID tonen",IDC_MB_SHOWHPID,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,350,258,72,12

    GROUPBOX        "ACARS",IDC_STATIC,16,292,468,42
    CONTROL         "Volledige pariteitscontrole",IDC_ACARS_PC_YES,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_TABSTOP,28,309,140,12
    CONTROL         "Geen pariteitscontrole",IDC_ACARS_PC_NO,"Button",BS_AUTORADIOBUTTON | WS_DISABLED | WS_TABSTOP,184,309,124,12

    GROUPBOX        "Optionele informatie in titelbalk",IDC_STATIC,16,342,468,44
    CONTROL         "FLEX-/ERMES-cycli en frames",IDC_SHOW_CFS,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,359,150,12
    CONTROL         "Afgewezen/geblokkeerde berichten",IDC_SHOW_REJECTBLOCKED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,202,359,174,12

    PUSHBUTTON      "Algemeen...",IDC_GENERALOPTIONS,250,398,74,20
    DEFPUSHBUTTON   "OK",IDOK,332,398,66,20
    PUSHBUTTON      "Annuleren",IDCANCEL,406,398,78,20
END

