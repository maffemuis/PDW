// Dutch (Netherlands) Windows 11 presentation resources for final visible legacy dialogs.
// Keep all control IDs aligned with Rsrc.rc; presentation/localization only.

#include "resrc1.h"
#include "windows.h"
#include "headers\resource.h"

LANGUAGE LANG_DUTCH, SUBLANG_DUTCH
#pragma code_page(65001)

FILTEREDITDLGBOX DIALOGEX 10, 10, 430, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - Filter toevoegen/bewerken"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Stel de filtervoorwaarden, weergave en uitvoer voor dit filter in.",IDC_STATIC,16,14,398,12
    GROUPBOX        "Filtervoorwaarden",IDC_STATIC,16,38,398,138
    CONTROL         "Opmerking: een grijs veld betekent 'Niet wijzigen'",IDC_DONTCHANGE,"Static",SS_LEFTNOWORDWRAP | NOT WS_VISIBLE | WS_BORDER | WS_GROUP,84,38,250,14
    CONTROL         "Afwijzen",IDC_FILTERREJECT,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,55,74,12
    LTEXT           "Filtertype:",IDC_STATIC,28,79,52,10
    COMBOBOX        IDC_FILTERTYPE,86,76,112,80,CBS_DROPDOWNLIST | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Audio:",IDC_STATIC,216,79,40,10
    COMBOBOX        IDC_FILTERAUDIO,260,76,138,140,CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Adres:",IDC_STATIC,28,105,52,10
    EDITTEXT        IDC_FILTERCAPCODE,86,102,112,18,ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP
    COMBOBOX        IDC_FILTERFNU,148,102,50,70,CBS_DROPDOWNLIST | CBS_NOINTEGRALHEIGHT | NOT WS_VISIBLE | WS_DISABLED | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Kleur:",IDC_STATIC,216,105,40,10
    COMBOBOX        IDC_FILTERLABELCOLOR,260,102,138,195,CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_NOINTEGRALHEIGHT | WS_DISABLED | WS_VSCROLL | WS_TABSTOP,WS_EX_TRANSPARENT
    LTEXT           "Tekst:",IDC_STATIC,28,131,52,10
    EDITTEXT        IDC_FILTERTEXT,86,128,112,18,ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP
    CONTROL         "Exact bericht vergelijken",IDC_FILTERMATCHEXACT,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,216,130,148,12
    CONTROL         "Mobitex RX/TX MAN",IDC_FILTERRXTXMAN,"Button",BS_AUTO3STATE | NOT WS_VISIBLE | WS_TABSTOP,216,130,120,12
    LTEXT           "Label:",IDC_STATIC,28,157,52,10
    EDITTEXT        IDC_FILTERLABEL,86,154,312,18,ES_AUTOHSCROLL | WS_DISABLED | WS_TABSTOP

    GROUPBOX        "Filtergedrag",IDC_STATIC,16,184,398,58
    CONTROL         "Filterlabel tonen",IDC_FILTERLABELEN,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,202,102,12
    CONTROL         "Alleen monitor",IDC_FILTER_MONITOR_ONLY,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,144,202,92,12
    CONTROL         "Filter-opdrachtbestand inschakelen",IDC_FILTERCMD,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,250,202,154,12
    CONTROL         "E-mail verzenden (uitgeschakeld)",IDC_FILTERSMTP,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,220,172,12

    GROUPBOX        "Trefferteller",IDC_HITCOUNTER_BOX,16,250,398,44,BS_NOTIFY
    LTEXT           "Aantal treffers: 0",IDC_FILTERHITS,28,267,112,10
    LTEXT           "",IDC_FILTERLASTHIT,146,267,168,10
    PUSHBUTTON      "Resetten",IDC_FILTERRESET,328,262,74,20,WS_DISABLED

    GROUPBOX        "Afzonderlijk filterbestand",IDC_SEPFILTERBOX,16,302,398,66
    CONTROL         "Afzonderlijk filterbestand inschakelen",IDC_SEPFILTERFILEEN,"Button",BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP,28,316,184,12
    PUSHBUTTON      "Bladeren...",IDC_SEPFILTERFILEBROWSE1,28,336,62,18,WS_DISABLED
    EDITTEXT        IDC_SEPFILTERFILE1,96,336,306,18,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    PUSHBUTTON      "Bladeren...",IDC_SEPFILTERFILEBROWSE2,28,346,62,18,NOT WS_VISIBLE
    EDITTEXT        IDC_SEPFILTERFILE2,96,346,306,18,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP
    PUSHBUTTON      "Bladeren...",IDC_SEPFILTERFILEBROWSE3,28,368,62,18,NOT WS_VISIBLE
    EDITTEXT        IDC_SEPFILTERFILE3,96,368,306,18,ES_AUTOHSCROLL | ES_READONLY | NOT WS_TABSTOP

    DEFPUSHBUTTON   "OK",IDOK,16,386,64,20
    PUSHBUTTON      "-",IDC_FILTER_PREVIOUS,96,386,32,20
    PUSHBUTTON      "Toepassen",IDC_FILTER_APPLY,144,386,78,20
    PUSHBUTTON      "+",IDC_FILTER_NEXT,238,386,32,20
    PUSHBUTTON      "Annuleren",IDCANCEL,328,386,86,20
    LTEXT           "",IDC_FILTEREDITHELP,0,408,430,12,SS_CENTERIMAGE,WS_EX_CLIENTEDGE
END

ACARS_COLORSDLGBOX DIALOGEX 10, 10, 390, 220
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "PDW - ACARS-kleuren"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Berichtonderdelen",IDC_STATIC,16,14,230,92
    PUSHBUTTON      "Berichtnr.",IDC_AC_COLORMSGNO,28,32,94,20
    PUSHBUTTON      "Tijd/datum",IDC_AC_COLORTIMESTAMP,132,32,94,20
    PUSHBUTTON      "DBI",IDC_AC_COLORDBI,28,58,94,20
    PUSHBUTTON      "Modus",IDC_AC_COLORMODE,132,58,94,20
    PUSHBUTTON      "Labels",IDC_AC_COLORTAGS,28,84,94,20
    PUSHBUTTON      "Bericht",IDC_AC_COLORMSG,132,84,94,20
    GROUPBOX        "Weergave",IDC_STATIC,254,14,120,92
    PUSHBUTTON      "Achtergrond",IDC_AC_COLORBACKGND,266,32,96,20
    PUSHBUTTON      "Filtertreffer",IDC_AC_COLORFILTMATCH,266,58,96,20
    PUSHBUTTON      "Bitfouten",IDC_AC_COLORBITERRORS,266,84,96,20
    PUSHBUTTON      "Filterlabel",IDC_AC_COLORFILTERLABEL,28,114,94,20
    CONTROL         "",IDC_AC_COLORWIN,"Static",SS_BLACKFRAME,16,142,358,40
    PUSHBUTTON      "Standaardkleuren",IDC_AC_COLORDEFAULT,16,190,106,20
    DEFPUSHBUTTON   "OK",IDOK,226,190,66,20
    PUSHBUTTON      "Annuleren",IDCANCEL,300,190,74,20
END

